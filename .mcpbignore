# MCPB Package Exclusions for Pluggist

# Development files
.next/
node_modules/
.turbo/
.cache/

# Build outputs (keep only production builds)
dist/
build/
out/

# Development tools
.eslintcache
*.tsbuildinfo
.vscode/
.idea/

# Environment files
.env*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output
test-results/
playwright-report/

# Documentation (keep main docs, exclude detailed dev docs)
documentation/deployment/
documentation/troubleshooting/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Version control
.git/
.gitignore

# Temporary files
*.tmp
*.temp
.temp/

# Lock files (keep package.json, exclude lock files)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Deployment specific
vercel.json
wrangler.toml
.vercel/

# Keep essential files for MCPB
!mcp-server/
!src/lib/supabase.ts
!src/types/supabase.ts
!public/
!components.json
!tailwind.config.ts
!next.config.ts
!tsconfig.json